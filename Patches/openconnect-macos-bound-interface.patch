+				exit(1);
+			}
+			snprintf(outbound_interface_name, sizeof(outbound_interface_name), "%s",
+				 selected_interface);
+			openconnect_set_protect_socket_handler(vpninfo, bind_outbound_socket);
+		}
+	}
+#endif
